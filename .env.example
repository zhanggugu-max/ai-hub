# 站点对外访问 URL（Vercel 上线后可填你的正式域名，例如 https://ai-hub.vercel.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 项目连接信息（可在 Supabase Dashboard -> Project Settings -> API 获取）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 仅限本地 Seed 脚本使用的服务端密钥（生产环境运行网页无需填到 Vercel 前端，除非后续加入服务端写入/后台任务）
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
